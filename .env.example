HF_TOKEN="your_hf_token"
HF_REPO="your_hf_repo"
APP_KEY_FILE="your_key_file_name"
HF_STORAGE_TOTAL_TB="8.8"

# Optional: extra Hugging Face accounts (beyond HF_TOKEN/HF_REPO above) to
# pool/replicate storage across. JSON array of {label, token, repo}.
# Same thing is editable in-app under Settings -> Accounts.
# HF_ACCOUNTS='[{"label":"acct2","token":"hf_...","repo":"buckets/you/vault-2"}]'

# Optional: default RAID layout for uploads — none | raid0 | raid1 | raid6.
# Falls back to a simpler mode automatically if too few accounts are configured.
# RAID_MODE="none"